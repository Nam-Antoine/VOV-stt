# ---------------------------------------------------------------------------
# vn-stt-corpus — copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=vnstt
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=vnstt
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full SQLAlchemy URL; api/worker build it from the parts above if unset.
DATABASE_URL=postgresql+psycopg://vnstt:change-me-in-production@db:5432/vnstt

# --- App ------------------------------------------------------------------
# Single shared password (PLAN §6). Session cookie is signed with SECRET_KEY.
APP_PASSWORD=change-me
SECRET_KEY=generate-with-openssl-rand-hex-32
SESSION_COOKIE_NAME=vnstt_session
SESSION_MAX_AGE_S=2592000
LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh

# --- Storage (PLAN §6) ----------------------------------------------------
# Host path bind-mounted at /data in api + worker.
DATA_DIR=/data
MODELS_DIR=/data/models
AUDIO_DIR=/data/audio
RAW_DIR=/data/raw
EXPORTS_DIR=/data/exports

# --- Engine (PLAN §2) -----------------------------------------------------
ASR_MODEL_DIR=/data/models/zipformer-30m-rnnt-6000h
ASR_INT8=true
ASR_NUM_THREADS=2
ASR_DECODING_METHOD=modified_beam_search
ASR_MAX_ACTIVE_PATHS=4
ASR_BLANK_PENALTY=0.25
HOTWORDS_SCORE=1.5

# --- VAD (PLAN §3) --------------------------------------------------------
VAD_MODEL=/data/models/vad/silero_vad.onnx
VAD_THRESHOLD=0.3
VAD_MIN_SPEECH_S=0.1
VAD_MIN_SILENCE_S=0.4
VAD_PAD_S=0.35
VAD_MERGE_GAP_S=0.3
VAD_MAX_SEGMENT_S=25.0
# Warn (not fail) when detected speech falls below this fraction of duration.
VAD_MIN_SPEECH_RATIO=0.70

# --- Diarization (PLAN §3) ------------------------------------------------
DIAR_SEGMENTATION_MODEL=/data/models/diarization/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
DIAR_EMBEDDING_MODEL=/data/models/diarization/speaker-embedding/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx
DIAR_THRESHOLD=0.7
DIAR_NUM_CLUSTERS=0
DIAR_MIN_DURATION_ON=0.3
DIAR_MIN_DURATION_OFF=0.5
DIAR_NUM_THREADS=2

# --- Worker ---------------------------------------------------------------
WORKER_POLL_INTERVAL_S=2.0
WORKER_MAX_ATTEMPTS=3
# 4 vCPU / 6 GB box: one worker, no parallel episodes (CLAUDE.md rule 6).
OMP_NUM_THREADS=2

# --- Optional second engine (PLAN §6, §11 T6) -----------------------------
# OFF by default. Turning this on sends audio abroad — reopens the Decree 13
# question. See LICENSE-NOTICE.md.
ENABLE_SCRIBE=false
ELEVENLABS_API_KEY=

# --- Caddy ----------------------------------------------------------------
# Use :80 for local dev; a real hostname enables automatic TLS.
SITE_ADDRESS=:80
# Host ports Caddy binds. Change these if something else already owns 80/443 on
# the box (a stray nginx, another compose project).
HTTP_PORT=80
HTTPS_PORT=443
